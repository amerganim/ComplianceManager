# Supabase — copy to .env and fill in from your Supabase project settings (API section)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side reminder job only (NEVER expose to the browser / never prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider for the reminder engine (Phase 4). Resend is simplest; swap freely.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
